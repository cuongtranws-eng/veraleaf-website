# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://veraleaf:CHANGE_ME@127.0.0.1:5432/veraleaf

# Secret used to sign auth tokens / cookies. Use a long random value (min. 32 chars).
# PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Public URL of the site (used for CORS/CSRF and absolute URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: extra allowed origins for the CMS API, comma separated
PAYLOAD_ALLOWED_ORIGINS=

# Optional: set to "false" to disable automatic schema push in development
# (then use `npm run migrate` locally too). Production never pushes.
PAYLOAD_DB_PUSH=

# Optional: used only by `npm run seed` to create the first administrator.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional: outgoing e-mail (admin "Forgot password"). Leave SMTP_HOST empty to only log e-mails.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_PASS=<Google App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=VeraLeaf CMS

# Docker only (docker-compose.yml): password of the bundled PostgreSQL container.
# With Docker, DATABASE_URL above is ignored (compose builds it from DB_PASSWORD).
DB_PASSWORD=
